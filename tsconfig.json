{
  "exclude": ["packages/*/fixtures"],
  "compilerOptions": {
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
